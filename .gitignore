# Godot / SDK generated
.godot/
venv/
*.exe
export/
*.log

# Python
__pycache__/
.pytest_cache/
*.egg-info/
TestGodotProject_Out/

# Godot-generated per-script UIDs (shipped ones stay tracked; ignore new noise)
*.uid

# Pruned upstream bulk (overlay these from the official SDK; see README):
# docs/ is generated HTML, python/ is the Windows-only bundle,
# FbExportData/ is required at runtime (level list, export data, thumbnails),
# raw/ is editor-ignored source metadata (.gdignore) with no local sources,
# terrain_3d/ is dormant upstream staging (unwired, self-referential).
docs/
python/
FbExportData/
GodotProject/raw/
code/gdplugins/terrain_3d/

# Duplicate upstream staging copies — canonical live plugins are tracked at
# GodotProject/addons/ (the copy Godot actually loads; also newer upstream,
# e.g. terrain_decal/bounds.json). code/gdplugins/terrain_3d/ stays tracked.
code/gdplugins/bf_portal/
code/gdplugins/scene-library/

# Linux-port working files (do not commit backups/logs)
.linux-port-backup/
linux-port-validation/

# Generated by Setup inside the editor (deterministic per SDK data version)
GodotProject/addons/scene-library/scene_library.json
